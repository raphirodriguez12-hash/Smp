# =============================================================
#  RUGGER SNIPER BOT — Configuration
# =============================================================

# --- Solana RPC ---
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WS_ENDPOINT=wss://api.mainnet-beta.solana.com
# Recommandé : Helius, QuickNode ou Alchemy pour de meilleures performances
# HELIUS_API_KEY=

# --- Wallet ---
# Clé privée Base58 du wallet de trading
PRIVATE_KEY=

# --- Montants & Risque ---
# Montant en SOL à investir par snipe
BUY_AMOUNT_SOL=0.1
# Slippage en % (ex: 15 = 15%)
SLIPPAGE_BPS=1500
# Priorité de transaction (microlamports)
PRIORITY_FEE_MICROLAMPORTS=100000

# --- Stratégie ---
# Take profit en % (ex: 100 = +100%, 2x)
TAKE_PROFIT_PERCENT=100
# Stop loss en % (ex: 30 = -30%)
STOP_LOSS_PERCENT=30
# Délai max entre achat et revente automatique (ms)
AUTO_SELL_DELAY_MS=60000
# Activer la revente automatique (true/false)
AUTO_SELL_ENABLED=true

# --- Filtres Token ---
# Liquidité minimale en SOL pour accepter un token
MIN_LIQUIDITY_SOL=5
# Nombre max de holders autorisés au moment du snipe (0 = désactivé)
MAX_HOLDERS=0
# Vérifier le renounce de mint authority
CHECK_MINT_RENOUNCED=false

# --- Rugger Watchlist ---
# Fichier contenant les wallets de ruggers à surveiller
RUGGER_WATCHLIST_FILE=./config/ruggers.json
# Mode watchlist : "include" (snipe seulement ces wallets) | "exclude" (blacklist)
WATCHLIST_MODE=include

# --- Axiom ---
# Clé API Axiom (optionnel, pour les fonctionnalités premium)
AXIOM_API_KEY=

# --- Logs ---
LOG_LEVEL=info
LOG_FILE=./logs/sniper.log
